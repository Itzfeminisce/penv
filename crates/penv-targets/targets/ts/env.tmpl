{%- macro read(key) -%}
{%- if key.type.name in ["number", "port"] -%}
{%- if key.required -%}
Number(process.env.{{ key.name }})
{%- else -%}
process.env.{{ key.name }} === undefined ? undefined : Number(process.env.{{ key.name }})
{%- endif -%}
{%- elif key.type.name == "boolean" -%}
{%- if key.required -%}
process.env.{{ key.name }} === "true"
{%- else -%}
process.env.{{ key.name }} === undefined ? undefined : process.env.{{ key.name }} === "true"
{%- endif -%}
{%- else -%}
process.env.{{ key.name }} as {{ key.lang_type }}{% if not key.required %} | undefined{% endif %}
{%- endif -%}
{%- endmacro -%}
// Generated by penv {{ penv.version }} from .env.schema. Do not edit.

export const env = {
{%- for key in keys %}
{%- if key.description %}
  /** {{ key.description }} */
{%- endif %}
  {{ key.name }}: {{ read(key) }},
{%- endfor %}
} as const;

export type Env = typeof env;

export const envSchema = {
  "~standard": {
    version: 1,
    vendor: "penv",
    validate: (value: unknown) => {
      const seen = (value ?? {}) as Record<string, unknown>;
      const issues: { message: string; path: [string] }[] = [];
{%- for key in keys %}
{%- if key.required %}
      if (seen[{{ key.name | quote }}] === undefined || seen[{{ key.name | quote }}] === "") {
        issues.push({ message: {{ (key.name ~ " is required") | quote }}, path: [{{ key.name | quote }}] });
      }
{%- endif %}
{%- if key.type.name == "enum" %}
      if (seen[{{ key.name | quote }}] !== undefined && !{{ key.type.members | json }}.includes(seen[{{ key.name | quote }}] as string)) {
        issues.push({ message: {{ (key.name ~ " must be one of " ~ (key.type.members | join(", "))) | quote }}, path: [{{ key.name | quote }}] });
      }
{%- endif %}
{%- endfor %}
      return issues.length > 0 ? { issues } : { value: seen as unknown as Env };
    },
  },
} as const;
